---
import { getCollection, render } from 'astro:content';
import Layout from '../../components/Layout.astro';
import ResearchHero from '../../components/ResearchHero.astro';
import { getRelatedResearch } from '../../lib/related-research';

export async function getStaticPaths() {
  const entries = await getCollection('research');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { data } = entry;

// ── Server-side topic mindmap (replaces old client-side buildMindmap()) ──
const TOPICS = [
  { id: 'ml', label: 'ML' },
  { id: 'bio', label: 'Biology' },
  { id: 'fin', label: 'Finance' },
  { id: 'econ', label: 'Economics' },
  { id: 'infra', label: 'AI Infra' },
  { id: 'neuro', label: 'Neuro' },
] as const;

const [allProjects, allResearch] = await Promise.all([
  getCollection('projects'),
  getCollection('research'),
]);

const relatedResearch = getRelatedResearch(entry, allResearch);

const byTopic: Record<string, string[]> = {};
for (const t of TOPICS) byTopic[t.id] = [];
for (const p of allProjects) {
  if (p.data.topic && byTopic[p.data.topic]) byTopic[p.data.topic].push(p.data.title);
}
for (const r of allResearch) {
  if (r.data.topic && byTopic[r.data.topic]) byTopic[r.data.topic].push(r.data.title);
}

const mindmapData = {
  center: 'Build & Research',
  branches: TOPICS.map((t) => ({ label: t.label, nodes: byTopic[t.id] })).filter(
    (b) => b.nodes.length > 0,
  ),
};
---
<Layout title={`${data.title} | Evint Leovonzko`} description={data.tagline}>
  <ResearchHero title={data.title} tagline={data.tagline} metrics={data.metrics} authors={data.authors} affiliation={data.affiliation} />
  <section id="overview" class="mindmap-section container">
    <p class="mindmap-section__heading">Concept Overview</p>
    <div id="mindmapContainer"></div>
  </section>
  <div class="research-body container">
    <div class="research-tags-row">
      <div class="research-tags">
        {data.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
      {data.simpleSummary && (
        <button
          type="button"
          id="cavemanToggle"
          class="caveman-toggle"
          aria-label="Toggle simple mode"
          title="Simple mode: plain-English rewrite"
        >
          <svg class="caveman-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="2.5" y="5" width="19" height="14" rx="2.5" ry="2.5"></rect>
            <path d="M7 11.5h2.5M7 14.5h3M13.5 11.5h3.5M13.5 14.5h3"></path>
          </svg>
          <span class="caveman-toggle__label">Simple mode</span>
        </button>
      )}
    </div>
    <article class="research-content">
      <Content />
    </article>
    {data.simpleSummary && (
      <div class="simple-summary">
        {data.simpleSummary.split('\n\n').map((paragraph) => (
          <p>{paragraph}</p>
        ))}
      </div>
    )}
    {relatedResearch.length > 0 && (
      <section class="cards" aria-labelledby="related-papers-heading">
        <p id="related-papers-heading" class="cards__heading">Related papers</p>
        <div class="cards__grid">
          {relatedResearch.map((r) => (
            <a class="cards__card" href={`/research/${r.id}/`}>
              <h3 class="cards__title">{r.data.title}</h3>
              <p class="cards__tagline">{r.data.tagline}</p>
            </a>
          ))}
        </div>
      </section>
    )}
    <a href="/research" class="back-to-portfolio">Back to Research</a>
  </div>
  <script type="application/json" id="mindmap-data" set:html={JSON.stringify(mindmapData)} />
  {data.chart && (
    <script type="application/json" id="chart-data" set:html={JSON.stringify(data.chart)} />
  )}
</Layout>

<script>
  import { initMindmap } from '../../islands/mindmap';
  const el = document.getElementById('mindmapContainer');
  const dataEl = document.getElementById('mindmap-data');
  if (el && dataEl) initMindmap(el, JSON.parse(dataEl.textContent || '{}'));
</script>

<script>
  import { initCavemanToggle } from '../../islands/caveman-mode';
  const cavemanBtn = document.getElementById('cavemanToggle');
  if (cavemanBtn) initCavemanToggle(cavemanBtn);
</script>

<script>
  // Chart container lives inside the MDX body content itself (each entry's
  // <div id="research-chart"> sits wherever the source page's chart figure
  // actually appeared — see bitcoin-portfolio-allocation.mdx/
  // crypto-stock-timing.mdx), not in this template — so there's at most one
  // per rendered page. The `chart` frontmatter field only carries
  // serializable data (height/logY/type/xs/series); formatX/formatY are
  // functions and can't survive the JSON round-trip, so they're
  // reconstructed here from the container's data-chart-format attribute,
  // matching each source page's actual original chart-init script.
  import { initResearchChart, type ResearchChartConfig } from '../../islands/research-chart';

  const chartEl = document.getElementById('research-chart') as HTMLElement | null;
  const chartDataEl = document.getElementById('chart-data');
  if (chartEl && chartDataEl) {
    const cfg = JSON.parse(chartDataEl.textContent || '{}') as ResearchChartConfig;
    const format = chartEl.dataset.chartFormat;
    if (format === 'btc-allocation') {
      // bitcoin-portfolio-allocation.html's original inline chart script:
      // formatX: x + '%', formatY: v.toFixed(0)
      cfg.formatX = (x) => `${x}%`;
      cfg.formatY = (v) => v.toFixed(0);
    } else if (format === 'lead-lag') {
      // crypto-stock-timing.html's original inline chart script:
      // formatX: signed lag + 'm', formatY: v.toFixed(2)
      cfg.formatX = (x) => `${Number(x) > 0 ? '+' : ''}${x}m`;
      cfg.formatY = (v) => v.toFixed(2);
    }
    initResearchChart(chartEl, cfg);
  }
</script>

<style>
  .research-body { padding-block: var(--space-8) var(--space-24); }
  .research-tags-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-4); margin-bottom: var(--space-8); }
  .research-tags { display: flex; gap: var(--space-2); }
  .caveman-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink-soft);
    cursor: pointer;
    transition: color var(--transition-base), border-color var(--transition-base);
  }
  .caveman-toggle:hover { color: var(--ink); border-color: var(--ink-soft); }
  .caveman-icon { width: 16px; height: 16px; }
  html.caveman .caveman-toggle { color: var(--accent); border-color: var(--accent); }

  .research-content { display: block; }
  .simple-summary { display: none; }
  html.caveman .research-content { display: none; }
  html.caveman .simple-summary { display: block; }
  .simple-summary p { margin-bottom: var(--space-4); line-height: 1.7; }

  .research-content :global(h2) { margin-top: var(--space-16); font-size: 1.75rem; border-top: 1px solid var(--border); padding-top: var(--space-8); }
  .back-to-portfolio { display: inline-block; margin-top: var(--space-16); font-family: var(--font-mono); text-decoration: none; color: var(--ink-soft); }

  /* Research chart (Task 23) — ported from assets/css/chart.css, current
     token names (see Task 20's port-decision notes: --text-tertiary ->
     --ink-faint, --border-primary -> --border, --bg-primary/--bg-secondary
     -> --paper-raised). :global() is required throughout: this markup
     lives inside the rendered MDX <Content /> (a different compiled
     component with its own scope hash) or is created client-side via
     research-chart.ts's createElementNS/createElement calls, so it never
     receives this file's data-astro-cid-* scope attribute — same
     reasoning as `.research-content :global(h2)` above and the mindmap
     precedent in src/islands/mindmap.ts. */
  .research-content :global(.chart-figure) { margin: var(--space-16) 0 0; }
  .research-content :global(.chart-figure__caption) { display: flex; flex-direction: column; gap: 2px; margin-bottom: var(--space-4); }
  .research-content :global(.chart-figure__title) { font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--ink-faint); }
  .research-content :global(.chart-figure__note) { font-size: 0.75rem; color: var(--ink-faint); font-style: italic; line-height: 1.5; }
  .research-content :global(.chart-figure__panel) { background: var(--paper-raised); border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--space-8) var(--space-4) var(--space-4); }
  .research-content :global(.chart) { position: relative; width: 100%; }
  .research-content :global(.chart__svg) { width: 100%; height: auto; display: block; overflow: visible; }
  .research-content :global(.chart__legend) { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-4); }
  .research-content :global(.chart__chip) {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: var(--space-1) var(--space-3);
    border-radius: 999px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
    transition: opacity var(--transition-base), border-color var(--transition-base), color var(--transition-base);
  }
  .research-content :global(.chart__chip:hover) { border-color: var(--accent); color: var(--accent); }
  .research-content :global(.chart__chip.is-muted) { opacity: 0.4; }
  .research-content :global(.chart__swatch) { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
  .research-content :global(.chart__tooltip) {
    position: absolute;
    pointer-events: none;
    background: var(--paper-raised);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-2) var(--space-3);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--ink);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.12);
    z-index: 5;
    min-width: 150px;
    line-height: 1.5;
  }
  .research-content :global(.chart__tiphead) { font-weight: 600; margin-bottom: var(--space-1); color: var(--ink-soft); }
  .research-content :global(.chart__tiprow) { display: flex; align-items: center; gap: var(--space-2); }
  .research-content :global(.chart__tiprow .chart__dot) { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .research-content :global(.chart__tiprow .chart__tipname) { color: var(--ink-soft); }
  .research-content :global(.chart__tiprow .chart__tipval) { margin-left: auto; font-weight: 600; }
  @media (max-width: 639px) {
    .research-content :global(.chart__chip) { font-size: 0.65rem; }
  }

  .cards { margin-top: var(--space-16); }
  .cards__heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--space-4);
  }
  .cards__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: var(--space-4);
  }
  .cards__card {
    display: block;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    text-decoration: none;
    color: inherit;
    background: var(--paper-raised);
    transition: border-color var(--transition-base);
  }
  .cards__card:hover { border-color: var(--ink-soft); }
  .cards__title { font-size: 1rem; margin-bottom: var(--space-2); }
  .cards__tagline { font-size: 0.875rem; color: var(--ink-soft); margin: 0; }

  .mindmap-section { padding-top: var(--space-8); }
  .mindmap-section__heading {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: var(--space-4);
  }
  #mindmapContainer {
    width: 100%;
    border-radius: var(--radius-md);
    background: var(--paper-raised);
    border: 1px solid var(--border);
    overflow: hidden;
  }
  /* :global() is required here: the <svg> is created client-side via
     document.createElementNS (src/islands/mindmap.ts), so it never receives
     Astro's data-astro-cid-* scope attribute and a scoped selector would
     never match it. Without this rule an SVG with only a viewBox (no
     width/height attrs) relies on the browser's default auto-sizing to fill
     its container — modern Chromium happens to do this today, but it's not
     guaranteed behavior, so this rule is a deliberate safety net, not
     redundant. */
  :global(#mindmapContainer svg) { width: 100%; height: auto; display: block; }

  @keyframes mindmap-in {
    from { opacity: 0; transform: scale(0.75); }
    to   { opacity: 1; transform: scale(1); }
  }
  #mindmapContainer :global(.mindmap-node) {
    animation: mindmap-in 0.35s ease-out both;
    transform-box: fill-box;
    transform-origin: center;
  }
  @keyframes mindmap-line-in {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  #mindmapContainer :global(.mindmap-line) {
    animation: mindmap-line-in 0.25s ease-out both;
  }
</style>
