---
import { getCollection } from 'astro:content';
import Layout from '../../components/Layout.astro';
import FeaturedProjectCard from '../../components/FeaturedProjectCard.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
---
<Layout title="Projects | Evint Leovonzko" description="Open-source tools, platforms, and applications built by Evint Leovonzko, spanning ML infrastructure, quantitative finance, neuroscience, and community platforms." ogDescription="Open-source tools, platforms, and applications built by Evint Leovonzko.">
  <section class="listing-hero container">
    <h1>Projects</h1>
    <p class="listing-hero__subtitle">Open-source tools, platforms, and applications</p>
  </section>

  <section class="container">
    <FeaturedProjectCard headingLevel="h2" />

    <ul class="project-grid">
      {projects.map((p) => (
        <li>
          <div class="project-grid__tags">
            {p.data.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
          <h2><a href={`/projects/${p.id}/`}>{p.data.title}</a></h2>
          <p>{p.data.tagline}</p>
          {p.data.tech.length > 0 && (
            <div class="project-grid__tech">
              {p.data.tech.map((t) => <span class="tag tag--tech">{t}</span>)}
            </div>
          )}
          <div class="project-grid__links">
            <a href={`/projects/${p.id}/`} class="project-grid__link">Learn More &rarr;</a>
            {p.data.paperLink && <a href={p.data.paperLink} class="project-grid__link">Read Paper &rarr;</a>}
            {p.data.repo && <a href={p.data.repo} target="_blank" rel="noopener noreferrer" class="project-grid__link">Repo &nearr;</a>}
          </div>
        </li>
      ))}
    </ul>
  </section>
</Layout>
<style>
  .listing-hero { padding-block: var(--space-16) var(--space-8); }
  .listing-hero__subtitle { color: var(--ink-soft); margin-top: var(--space-4); }

  .tag { display: inline-block; font-family: var(--font-mono); font-size: 0.75rem; color: var(--ink-soft); background: var(--paper); border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 2px 8px; }
  .tag--tech { color: var(--ink-faint); }

  .project-grid { list-style: none; padding: 0; margin: 0 0 var(--space-24); display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-6); }
  .project-grid > li { border: 1px solid var(--border); border-radius: var(--radius-md); padding: var(--space-6); background: var(--paper-raised); transition: border-color var(--transition-base); }
  .project-grid > li:hover { border-color: var(--ink-soft); }
  .project-grid a { text-decoration: none; color: inherit; }
  .project-grid h2 a:hover { color: var(--accent); }
  .project-grid__tags { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-4); }
  .project-grid h2 { font-size: 1.5rem; margin-bottom: var(--space-2); }
  .project-grid p { color: var(--ink-soft); margin: 0 0 var(--space-4); }
  .project-grid__tech { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-4); }
  .project-grid__links { display: flex; flex-wrap: wrap; gap: var(--space-4); }
  .project-grid__link { font-family: var(--font-mono); font-size: 0.8rem; font-weight: 600; color: var(--accent); }
  .project-grid__link:hover { text-decoration: underline; }

  @media (max-width: 767px) {
    .listing-hero { padding-block: var(--space-12) var(--space-6); }
  }
  @media (max-width: 639px) {
    .project-grid { grid-template-columns: 1fr; }
  }
</style>
